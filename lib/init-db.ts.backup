async function initializeServices() {
  try {
    console.log("🔗 Connecting to MongoDB...");
    await clientPromise;

    console.log("🗑️ Clearing existing services...");
    await Service.deleteMany({});

    console.log("📦 Creating services...");
    const services = await Service.create(servicesData);

    console.log(`✅ Successfully created ${services.length} services:`);
    services.forEach((service, index) => {
      console.log(`${index + 1}. ${service.name} (${service.type})`);
    });

    console.log("\n📊 Service Statistics:");
    const stats = await Service.getServiceAnalytics();
    console.log(stats);
  } catch (error) {
    console.error("❌ Error initializing services:", error);
  }
}

async function initializeBlogPosts() {
  try {
    const { Post } = await import("../models");

    const postsData = [
      {
        title: "The Complete Guide to Choosing the Right Tutor for Your Child",
        excerpt:
          "Discover the essential factors to consider when selecting a tutor, from qualifications and teaching style to personality fit and learning goals.",
        content: `Finding the right tutor can make all the difference in your child's academic journey. Whether your child is struggling with a particular subject or looking to excel even further, the right tutor can provide personalized attention and support that helps them reach their full potential.

## Key Factors to Consider

### 1. Qualifications and Experience
Look for tutors who have relevant educational backgrounds and experience in the subjects they teach. A good tutor should have both academic knowledge and the ability to communicate effectively with children.

### 2. Teaching Style Compatibility  
Every child learns differently. Some are visual learners, others prefer hands-on activities, and some learn best through auditory instruction. Find a tutor whose teaching style matches your child's learning preferences.

### 3. Personality and Rapport
The relationship between tutor and student is crucial. Your child should feel comfortable asking questions and making mistakes. Look for someone who is patient, encouraging, and able to build confidence.

### 4. Clear Goals and Progress Tracking
A good tutor will work with you to establish clear learning objectives and provide regular updates on your child's progress. They should be able to adapt their approach based on your child's needs.

## Red Flags to Avoid

- Tutors who don't communicate regularly with parents
- Those who promise unrealistic improvements in short timeframes  
- Lack of proper credentials or references
- Unwillingness to provide a trial session

## Making the Final Decision

Take time to interview potential tutors and observe how they interact with your child. Trust your instincts – if something doesn't feel right, keep looking. The right tutor will not only improve your child's academic performance but also boost their confidence and love of learning.`,
        authorName: "Dr. Sarah Mitchell",
        authorImage: "/woman1.jpg",
        authorBio:
          "Educational consultant with over 15 years of experience in child development and academic support.",
        category: "Education Tips",
        tags: ["Tutoring", "Education", "Parenting", "Academic Success"],
        keywords: ["tutor selection", "academic help", "education tips"],
        featuredImage: "/vision.jpg",
        status: "published",
        publishedAt: new Date("2025-09-15"),
        readTime: 8,
        slug: "complete-guide-choosing-right-tutor",
        isFeatured: true,
        relatedServices: ["tutoring"],
        targetAgeGroup: { min: 5, max: 18 },
      },
      {
        title: "5 Creative Learning Activities for Preschoolers at Home",
        excerpt:
          "Transform your home into a learning playground with these engaging activities that promote early childhood development.",
        content: `Learning doesn't have to stop when your preschooler comes home from school or daycare. In fact, some of the most meaningful learning experiences happen in the comfort and familiarity of home. Here are five creative activities that will engage your little one while supporting their development.

## 1. Kitchen Science Experiments

The kitchen is a natural laboratory for curious minds! Simple experiments like mixing baking soda and vinegar, or watching ice melt, introduce basic scientific concepts while being incredibly fun.

**What you'll need:** Common kitchen ingredients
**Learning benefits:** Science concepts, observation skills, cause and effect

## 2. Story Creation with Props

Gather random objects from around the house and challenge your child to create a story incorporating all the items. This activity sparks creativity and develops narrative skills.

**What you'll need:** Various household objects
**Learning benefits:** Language development, creativity, problem-solving

## 3. Nature Scavenger Hunts

Create a list of items for your child to find during outdoor time – different shaped leaves, smooth rocks, or flowers of specific colors.

**What you'll need:** A simple list, collection bag
**Learning benefits:** Observation skills, nature awareness, following directions

## 4. DIY Counting Games

Use everyday items like buttons, pasta, or toys to create counting activities. Sort by color, count by twos, or create simple addition problems.

**What you'll need:** Various small objects
**Learning benefits:** Math skills, categorization, fine motor skills

## 5. Art with Purpose

Instead of random coloring, give art projects a goal – draw your family, create a map of your neighborhood, or illustrate a favorite story.

**What you'll need:** Art supplies, imagination
**Learning benefits:** Fine motor skills, self-expression, attention to detail

Remember, the key is to follow your child's interests and keep activities short and engaging. Learning should feel like play at this age!`,
        authorName: "Emily Rodriguez",
        authorImage: "/woman2.jpg",
        category: "Early Learning",
        tags: ["Preschool", "Activities", "Home Learning"],
        featuredImage: "/tutoring.jpg",
        status: "published",
        publishedAt: new Date("2025-09-12"),
        readTime: 5,
        slug: "5-creative-learning-activities-preschoolers-home",
        relatedServices: ["childcare", "kiddies-enrichment"],
        targetAgeGroup: { min: 3, max: 5 },
      },
    ];

    console.log("🔗 Creating blog posts...");
    const posts = await Post.create(postsData);

    console.log(`✅ Successfully created ${posts.length} blog posts:`);
    posts.forEach((post, index) => {
      console.log(`${index + 1}. ${post.title}`);
    });
  } catch (error) {
    console.error("❌ Error initializing blog posts:", error);
  }
}

// Main initialization function
async function initializeDatabase() {
  try {
    console.log("🚀 Starting database initialization...\n");

    await initializeServices();
    console.log("\n");
    await initializeBlogPosts();

    console.log("\n🎉 Database initialization completed successfully!");
    console.log("\nYou can now:");
    console.log("- Submit booking forms at /register");
    console.log("- View services at /services");
    console.log("- Read blog posts at /blog");
    console.log("- Make API requests to /api/bookings, /api/services, etc.");
  } catch (error) {
    console.error("❌ Database initialization failed:", error);
  } finally {
    process.exit(0);
  }
}

// Run initialization if this file is executed directly
if (require.main === module) {
  initializeDatabase();
}

export { initializeServices, initializeBlogPosts, initializeDatabase };
